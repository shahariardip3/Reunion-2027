# Copy this file to .env.local and fill in your own values. NEVER upload .env.local anywhere.

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Use the SECRET key: the "service_role" key (starts with eyJ…) or the new "sb_secret_…" key.
# Do NOT use the anon / publishable key — saving settings, notices and registrations would fail.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_SECRET_KEY

ADMIN_PASSWORD=Use_a_unique_password_at_least_16_characters
ADMIN_SECRET=Generate_a_random_secret_of_at_least_32_characters

# Your public website address (no trailing slash). Needed for Google SEO: sitemap, link previews, structured data.
SITE_URL=
# Optional: Google Search Console "HTML tag" verification code (only the content="…" value)
GOOGLE_SITE_VERIFICATION=
# Required to protect the background email queue endpoint. Generate a random 32+ character secret.
CRON_SECRET=Generate_a_random_cron_secret_at_least_32_characters

# Gmail SMTP (server-side only)
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-google-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
